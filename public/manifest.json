      "icons": [{ "src": "/favicon.png", "sizes": "192x192" }]
    },
    {
      "name": "Catálogo de Animes",
      "short_name": "Animes",
      "description": "Assistir animes dublados e legendados",
      "url": "/animes?source=taskbar_animes",
      "icons": [{ "src": "/favicon.png", "sizes": "192x192" }]
    },
    {
      "name": "Minha Lista (Favoritos)",
      "short_name": "Favoritos",
      "description": "Abrir minha lista de títulos salvos",
      "url": "/favoritos?source=taskbar_favoritos",
      "icons": [{ "src": "/favicon.png", "sizes": "192x192" }]
    }
